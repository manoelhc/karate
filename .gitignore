# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

/.local/
.env
.env.*
*.profraw
*.profdata
.DS_Store
__pycache__/
.venv/

# Preserve sanitized verification logs despite global *.log ignores.
!docs/specker/runs/2026-11-04-karate/evidence/*.log
!docs/specker/runs/2026-11-04-karate/evidence/projects/*.log
!docs/specker/runs/2026-11-04-karate/evidence/membership/*.log
!docs/specker/runs/2026-11-04-karate/evidence/invitations/*.log
!docs/specker/runs/2026-11-04-karate/evidence/keys/*.log
!docs/specker/runs/2026-11-04-karate/evidence/discovery/*.log
!docs/specker/runs/2026-11-04-karate/evidence/sessions/*.log
!docs/specker/runs/2026-11-04-karate/evidence/tenants/*.log

# Local frontend toolchain and verification outputs
web/node_modules/
web/dist/
web/coverage/
web/test-results/
web/playwright-report/
!docs/specker/runs/2026-11-04-karate/evidence/web/*.log
